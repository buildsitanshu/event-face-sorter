# event-face-sorter settings. Copy to .env to use them: cp .env.example .env
# Every line is optional. Command-line flags (--photos, --people) override these.

# ---- Local folders (the normal way to use this tool) ----
# The folder of photos and videos to sort. The tool only reads it and never changes it.
CONVO_MEDIA_DIR=
# Optional folder of headshots, one clear photo per person, named like "Asha Rao.jpg".
CONVO_ROSTER_DIR=
# Where the database, previews, sorted folders and gallery are written. Must be outside the photo folder.
# CONVO_DATA_DIR=/path/to/output
# Hide people who appear in fewer photos than this (default 2).
# CONVO_MIN_PHOTOS=2
# How the sorted folders get the originals: copy, hardlink (no extra disk space) or symlink.
# CONVO_SORT_MODE=copy
# Frames per second sampled from each video to find faces (default 0.5, one frame every 2 seconds).
# CONVO_VIDEO_FPS=0.5

# ---- Google Drive mode (second-class, see the README) ----
# The Drive folder id of the photos and videos (the part after /folders/ in the folder URL).
CONVO_ROOT_FOLDER_ID=
# The Drive folder id of the headshots (optional).
CONVO_ROSTER_FOLDER_ID=
# Path of the token file written by scripts/drive_auth.py.
CONVO_OAUTH=~/.config/event-face-sorter/oauth.json
